<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% include "partials/meta.njk" %}

    <link rel="stylesheet" href="{{ '/css/tokens.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/general.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/header.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/footer.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/support-widget.css' | url }}" />
    {% for stylesheet in styles %}
    <link rel="stylesheet" href="{{ ('/css/' + stylesheet + '.css') | url }}" />
    {% endfor %}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    {% include "partials/jsonld-organization.njk" %}
  </head>

  <body class="{{ bodyClass }}">
    {% include "partials/header.njk" %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}
    {% include "partials/support-widget.njk" %}

    <script src="{{ '/js/header.js' | url }}"></script>
    <script src="{{ '/js/support-widget.js' | url }}"></script>
    {% if usesLightbox %}
    <script src="{{ '/js/image-popup.js' | url }}"></script>
    {% endif %}
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
